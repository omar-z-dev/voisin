{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}



<header class="site-header">
    <nav class="navbar container">
        <div class="logo">
            <a href="{{ path('app_feed') }}">Voisin.</a>
        </div>

        <ul class="menu">
            {% if app.user %}
                <li class="user-menu">
                    <span class="bonjour">
                        Bonjour {{ app.user.pseudo }}
                    </span>

                    {# Avatar #}
                    {% if app.user.photo %}
                            <img
                                class="avatar"
                                src="{{ asset('uploads/profile/' ~ app.user.photo) }}"
                                alt="Photo de profil"
                            >
                        {% else %}
                            <img
                                class="avatar"
                                src="{{ asset('images/avatar-default.png') }}"
                                alt="Photo de profil"
                            >
                    {% endif %} 
                </li>
            {% endif %}
            <li>
                <a href="{{ path('app_feed') }}">Accueil</a>
            </li>

            <li>
                <a href="{{ path('app_mon_profil') }}">
                    Mon profil
                </a>
            </li>

            <li>
                <a href="{{ path('app_amis') }}">Mes amis</a>
            </li>

            <li>
                <a href="{{ path('app_logout') }}">Se déconnecter</a>
            </li>
        </ul>
    </nav>
</header>

<main class="main">
    <div class="profil">

        <h2>Mon profil :</h2>

        {% if user.photo %}
            <img
                src="{{ asset('uploads/profile/' ~ user.photo) }}"
                alt="Photo de profil"
            >
        {% endif %}

        <h2>{{ user.pseudo }}</h2>

        {% if user.bio %}
            <p>{{ user.bio }}</p>
        {% endif %}

        <p>
            Inscrit le {{ user.dateInscription|date('d/m/Y') }}
        </p>

        <a class="btn-editer" href="{{ path('app_mon_profil_modifier') }}">
            Modifier
        </a>
    </div>
    {# liste des mes publication #}
    <h2> Mes publications : </h2>
    <div class="all-pubs">
        
        {% for publication in publications %}
            <article class="pub">
                <h3>Publié par : {{ publication.user.pseudo }}</h3>
                <p>{{ publication.texte }}</p>
                {% if publication.image %}
                    <img
                        src="{{ asset('uploads/publications/' ~ publication.image) }}"
                        alt="Image de la publication"
                    >
                {% endif %}
                <small>
                    Publié le {{ publication.dateCreation|date('d/m/Y à H:i') }}
                </small>

                {% if publication.user == app.user %}

                    <a class="btn-editer" href="{{ path('app_publication_modifier', {'id': publication.id}) }}">
                        Modifier
                    </a>
                    <form method="post" action="{{ path('app_publication_supprimer', {'id': publication.id}) }}">
                        <button class="btn-editer" type="submit">Supprimer</button>
                    </form>
                {% endif %}

                {# lien vers la page de la publication #}
                <a class="btn-editer"
                    href="{{ path('app_publication_afficher', {'id': publication.id}) }}">
                        Voir
                </a>
            </article>
        {% else %}
            <p>Aucune publication pour le moment.</p>
        {% endfor %}
    </div>
    
    {# btn retour #}
    <a class="btn-editer" href="{{ path('app_feed') }}">
        Retour
    </a>
</main>

{% endblock %}