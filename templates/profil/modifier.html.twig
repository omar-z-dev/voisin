{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block body %}

<header class="site-header">
    <nav class="navbar container">
        <div class="logo">
            <a href="{{ path('app_feed') }}">Voisin.</a>
        </div>

        <ul class="menu">
            {% if app.user %}
                <li>
                    <span class="bonjour">
                        Bonjour {{ app.user.pseudo }}
                    </span>
                </li>
            {% endif %}
            <li>
                <a href="{{ path('app_feed') }}">Accueil</a>
            </li>

            <li>
                <a href="{{ path('app_mon_profil') }}">
                    Mon profil
                </a>
            </li>

            <li>
                <a href="{{ path('app_amis') }}">Mes amis</a>
            </li>

            <li>
                <a href="{{ path('app_logout') }}">Se déconnecter</a>
            </li>
        </ul>
    </nav>
</header>

<main class="main">
    <div class="profil">

        <h1>Modifier mon profil</h1>

        {{ form_start(form) }}

            {{ form_row(form.pseudo) }}

            {{ form_row(form.bio) }}

            {{ form_row(form.photo) }}

            <button type="submit" class="btn-editer">
                Enregistrer
            </button>

        {{ form_end(form) }}

        <br>

        <a class="btn-editer" href="{{ path('app_mon_profil') }}">
            Annuler
        </a>

    </div>
</main>

{% endblock %}