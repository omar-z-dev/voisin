{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block body %}

<div class="profil">

    <h1>Modifier mon profil</h1>

    {{ form_start(form) }}

        {{ form_row(form.pseudo) }}

        {{ form_row(form.bio) }}

        {{ form_row(form.photo) }}

        <button type="submit" class="btn-editer">
            Enregistrer
        </button>

    {{ form_end(form) }}

    <br>

    <a class="btn-editer" href="{{ path('app_mon_profil') }}">
        Annuler
    </a>

</div>

{% endblock %}