{% extends 'base.html.twig' %}

{% block title %}Nouvelle publication{% endblock %}

{% block body %}

<header class="site-header">
    
    <nav class="navbar container">
        <div class="logo">
            <a href="{{ path('app_feed') }}">Voisin.</a>
        </div>

        <ul class="menu">
            <li class="user-menu">
                    <span class="bonjour">
                        Bonjour {{ app.user.pseudo }}
                    </span>

                    {# Avatar #}
                    {% if app.user.photo %}
                            <img
                                class="avatar"
                                src="{{ asset('uploads/profile/' ~ app.user.photo) }}"
                                alt="Photo de profil"
                            >
                        {% else %}
                            <img
                                class="avatar"
                                src="{{ asset('images/avatar-default.png') }}"
                                alt="Photo de profil"
                            >
                    {% endif %} 
                </li>
            <li>
                <a href="{{ path('app_feed') }}">Accueil</a>
            </li>

            <li>
                <a href="{{ path('app_mon_profil') }}">
                    Mon profil
                </a>
            </li>

            <li>
                <a href="{{ path('app_amis') }}">Mes amis</a>
            </li>

            <li>
                <a href="{{ path('app_logout') }}">Se déconnecter</a>
            </li>
        </ul>
    </nav>
</header>

<div class="form-ajouter">

    <h1>Créer une publication</h1>

   {{ form_start(form, {'attr': {'class': 'publication-form'}}) }}

        {{ form_row(form.texte) }}
        {{ form_row(form.image) }}
        {{ form_row(form.visibilite) }}

        <button class="btn-ajouter" type="submit">Publier</button>
        <div>
            <a  href="{{ path('app_feed') }}" class="btn-editer">
                Retour
            </a>
        </div>

    {{ form_end(form) }}

</div>

{% endblock %}