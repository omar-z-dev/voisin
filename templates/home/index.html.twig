{% extends 'base.html.twig' %}

{% block title %}Voisin. - Accueil{% endblock %}

{% block body %}

    <header class="site-header">

        <nav class="navbar container">
            <div class="logo">
                <a href="{{ path('app_home') }}">Home</a>
            </div>
            <ul class="menu">
                <li>
                    <a href="{{ path('app_login') }}">Se connecter</a>
                </li>
                <li>
                    <a href="{{ path('app_register') }}">Créer un compte</a>
                </li>
            </ul>
        </nav>
    </header>

    <main>
        <section class="bienvenue">
            <h2>Bienvenue sur Voisin.</h2>
            <p>
                Partagez, échangez et créez des liens avec les autres membres.
            </p>
        </section>

        <section>
            <h2>Publications récentes :</h2>
            <div class="all-pubs">
                {% if publications is empty %}

                    <p>Aucune publication pour le moment.</p>

                {% else %}

                    {% for publication in publications %}

                        <article class="pub">

                            <h3>{{ publication.user.pseudo }}</h3>

                            <p>{{ publication.texte }}</p>

                            {% if publication.image %}
                                <img
                                    src="{{ asset('uploads/publications/' ~ publication.image) }}"
                                    alt="Image de la publication"
                                >
                            {% endif %}

                            <p>
                                Publié le {{ publication.dateCreation|date('d/m/Y à H:i') }}
                            </p>

                        </article>

                    {% endfor %}

                {% endif %}
            </div>
        </section>
    </main>

{% endblock %}