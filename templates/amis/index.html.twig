{% extends 'base.html.twig' %}
{% block title %}Mes amis - Voisin.{% endblock %}
{% block body %}

<header class="site-header">
    <nav class="navbar container">
        <div class="logo">
            <a href="{{ path('app_feed') }}">Voisin.</a>
        </div>
        <ul class="menu">
            {% if app.user %}
                <li>
                    <span class="bonjour">
                        Bonjour {{ app.user.pseudo }}
                    </span>
                </li>
            {% endif %}
            <li>
                <a href="{{ path('app_feed') }}">Accueil</a>
            </li>
            <li>
                <a href="#">Mon profil</a>
            </li>
            <li>
                <a href="{{ path('app_amis') }}">Mes amis</a>
            </li>
            <li>
                <a href="{{ path('app_logout') }}">Se déconnecter</a>
            </li>
        </ul>
    </nav>
</header>

<main>
    <h2>Hello {{ user.pseudo }}</h2>

    {# Liste de Mes amis #}

    <h1>Mes amis :</h1>
    <div class="amis-container">
        {% for amitie in amities %}
            {% if amitie.demandeur == app.user %}
                {% set ami = amitie.destinataire %}
            {% else %}
                {% set ami = amitie.demandeur %}
            {% endif %}

            <div class="ami">
                <h3>{{ ami.pseudo }}</h3>

                {% if ami.photo %}
                    <img
                        src="{{ asset('uploads/profile/' ~ ami.photo) }}"
                        alt="Photo de {{ ami.pseudo }}"
                    >
                {% endif %}
            </div>
        {% else %}
            <p>Vous n'avez pas encore d'amis.</p>
        {% endfor %}
    </div>


    {# Les demande d'amis recus #}

    <a href="{{ path('app_demandes') }}" class="demandes-link">
        Mes demandes
        <span class="badge">{{ demandes|length }}</span>
    </a>

    {# Les utilisateurs disponibles #}

     <h2>Les utilisateurs disponibles :</h2>

        <div class="utilisateurs">
            {% for utilisateur in utilisateurs %}
                {% if utilisateur != app.user %}
                    <div class="utilisateur">
                        
                        {% if utilisateur.photo %}
                            <img
                                src="{{ asset('uploads/profile/' ~ utilisateur.photo) }}"
                                alt="Photo de {{ utilisateur.pseudo }}"
                            >
                        {% endif %}

                        <h3>{{ utilisateur.pseudo }}</h3>

                        <a class="btn-editer" href="{{ path('app_profil', {'id': utilisateur.id}) }}">
                            Voir le profil
                        </a>
                    </div>
                {% endif %}
            {% endfor %}
        </div>
</main>
{% endblock %}