{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
    <form class ="login-form"  method="post">
        
        {% if error %}
            <div class="alert alert-danger">
                Email ou mot de passe incorrect.
            </div>
        {% endif %}

        <h1>Se connecter</h1>
        
        {# email #}
        <label for="username">Email</label>
        <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" sautocomplete="email" autofocus>

        {# password #}
        <label for="password">Mot de passe</label>
        <input type="password" name="_password" id="password" 
        class="form-control" autocomplete="current-password" >

        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

        {# btn se connecter  #}
        <button class="space btn-ajouter" type="submit">
            Se connecter
        </button>
        <p class="creer-compte">
            Vous n'avez pas de compte ?
            <a class ="btn-creer-compte" href="{{ path('app_register') }}">
                Créer votre compte
            </a>
        </p>
        {# btn retour #}
        <a class="space btn-editer" href="{{ path('app_home') }}">
            Retour à l'accueil
        </a>
    </form>
{% endblock %}
