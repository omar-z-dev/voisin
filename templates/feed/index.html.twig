{% extends 'base.html.twig' %}
{% block title %}Voisin. - Fil d'actualité{% endblock %}
{% block body %}
<header class="site-header">
    <nav class="navbar container">
        <div class="logo">
            <a href="{{ path('app_feed') }}">Voisin.</a>
        </div>
        <ul class="menu">
             {% if app.user %}
                <li class="user-menu">
                    <span class="bonjour">
                        Bonjour {{ app.user.pseudo }}
                    </span>

                    {# Avatar #}
                    {% if app.user.photo %}
                            <img
                                class="avatar"
                                src="{{ asset('uploads/profile/' ~ app.user.photo) }}"
                                alt="Photo de profil"
                            >
                        {% else %}
                            <img
                                class="avatar"
                                src="{{ asset('images/avatar-default.png') }}"
                                alt="Photo de profil"
                            >
                    {% endif %} 
                </li>
            {% endif %}
            <li>
                <a href="{{ path('app_feed') }}">Accueil</a>
            </li>
            <li>
                <a href="{{ path('app_mon_profil') }}">
                    Mon profil
                </a>
            </li>
            <li>
                <a href="{{ path('app_amis') }}">Mes amis</a>
            </li>
            <li>
                <a href="{{ path('app_logout') }}">Se déconnecter</a>
            </li>
        </ul>
    </nav>
</header>
<main>
    <section class="publications">

        <h2>Fil d'actualité</h2>

        {# filtrer les publications #}
        <form class="filtre" method="get" action="{{ path('app_feed') }}">
            <label for="filtre">Filterer les publications :</label>

            <select name="filtre" id="filtre" onchange="this.form.submit()">
                <option value="toutes" {% if filtre == 'toutes' %}selected{% endif %}>
                    Toutes les publications visibles
                </option>

                <option value="publiques" {% if filtre == 'publiques' %}selected{% endif %}>
                    Publiques uniquement
                </option>

                <option value="amis" {% if filtre == 'amis' %}selected{% endif %}>
                    Amis uniquement
                </option>
            </select>
        </form>

        {# Nouvelle publication #}
        <a class="btn-ajouter" href="{{ path('app_publication_new') }}">
            Créer une publication
        </a>

        {# liste des publication #}
        <div class="all-pubs">
            {% for publication in publications %}
                <article class="pub">
                    <h3>Publié par : {{ publication.user.pseudo }}</h3>
                    <p>{{ publication.texte }}</p>
                    {% if publication.image %}
                        <img
                            src="{{ asset('uploads/publications/' ~ publication.image) }}"
                            alt="Image de la publication"
                        >
                    {% endif %}
                    <small>
                        Publié le {{ publication.dateCreation|date('d/m/Y à H:i') }}
                    </small>

                    {% if publication.user == app.user %}

                        <a class="btn-editer" href="{{ path('app_publication_modifier', {'id': publication.id}) }}">
                            Modifier
                        </a>
                        <form method="post" action="{{ path('app_publication_supprimer', {'id': publication.id}) }}">
                            <button class="btn-editer" type="submit">Supprimer</button>
                        </form>
                    {% endif %}

                    {# lien vers la page de la publication #}
                    <a class="btn-editer"
                        href="{{ path('app_publication_afficher', {'id': publication.id}) }}">
                            Voir
                    </a>
                </article>
            {% else %}
                <p>Aucune publication pour le moment.</p>
            {% endfor %}
        </div>
       
    </section>
</main>
{% endblock %}